# Public source export: deny by default, admit only reviewable source files.
*
!*/
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.zh-CN.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/plugin.toml
!/profiles.toml
!/config.example.toml
!/pytest.ini
!/run_tests.py
!/run_tests.bat
!/__init__.py
!/mcp_server.py
!/runtime/*.py
!/ui/*.tsx
!/tests/*.py
!/host/*.py
!/host/*.cs
!/host/*.js
!/host/*.cjs
!/host/voice-dependencies.lock.json
!/host/licenses/LICENSE
!/host/licenses/NOTICE.txt
!/host/licenses/cloudflared-LICENSE
!/host/licenses/FFmpeg-COPYING.GPLv3
!/host/licenses/FFmpeg-license-info.txt
!/integrations/motion_service/*.py
!/integrations/motion_service/README.md
!/integrations/verify_continuous_generator.py
!/Docs/Protocols/*.md
!/Docs/Protocols/*.json
!/Docs/VALIDATION.md
!/scripts/*.py
!/unity/README.md
!/unity/Assets/NEKO/**/*.cs
!/unity/Assets/NEKO/**/*.cs.meta
!/.github/workflows/*.yml

